# C# build output
bin/
obj/
*.user

# テスト実行の成果物（dotnet test --blame / --collect が作る）
TestResults/

# NuGet packages
*.nupkg
packages/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor directories
.vscode/*
.vs/*
!.vscode/extensions.json
.idea/

# Claude directories
# rules/ だけは共有したいので追跡対象に残す。
# `.claude/` とディレクトリごと除外すると配下の否定（!）が効かなくなるため
# `.claude/*` と書いている。
.claude/*
!.claude/rules/
!.claude/skills/
.claude/skills/*
!.claude/skills/release/
.claude/skills/release/*
!.claude/skills/release/SKILL.md

# Release output
publish/

# Local dev tools
tools/

# Logs
*.log
# dotagents: Codex temporary output
.codex/worktrees/
.codex/logs/
.codex/screenshots/
.codex/release.lock
.codex/import-backup/
