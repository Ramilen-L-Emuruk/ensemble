<!-- ShutdownMode: 既定の OnLastWindowClose だと、サブウィンドウ（ミキサー・プレイリスト等）が
     OnClosing で e.Cancel=true; Hide() する設計のため Application.Windows から除去されず、
     メインウィンドウを閉じてもプロセスが終了しない（ゾンビ化して単一起動用の Mutex を握り続け、
     以後アプリを起動できなくなる）。メインウィンドウの終了をアプリ終了とみなす -->
<Application x:Class="MultiTrackPlayer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TransportBtn" TargetType="Button">
            <!-- Focusable="False": Button はクリックでキーボードフォーカスを取り、Space は
                 フォーカス中のボタンを押す。そのため一度ボタンを押すと、以降の Space が
                 再生/一時停止ではなく直前に押したボタンの再実行になる（⏹ を押した後の Space で
                 停止し続ける、⏩ を押した後の Space で送り続ける）。
                 この 6 ボタンの動作はすべてキーバインドを持つ（再生/一時停止=Space・S、送り/戻し=←→、
                 前/次ファイル=P・N、停止=Ctrl+S）ため、ボタンにフォーカスを当てる価値は無い。
                 マウス操作は影響を受けない。失うのは Tab でボタンへ辿って Enter で押す経路
                 （ショートカットを知らない利用者向け）だけ -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>