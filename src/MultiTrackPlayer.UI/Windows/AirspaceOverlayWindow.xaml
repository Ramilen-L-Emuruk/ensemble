<Window x:Class="MultiTrackPlayer.UI.Windows.AirspaceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MultiTrackPlayer.UI"
        xmlns:ctrl="clr-namespace:MultiTrackPlayer.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False">
    <Window.Resources>
        <ui:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis"/>
    </Window.Resources>
    <!-- RootGrid に背景は敷かない。敷くとフルスクリーン中にウィンドウ全面が入力を受けるようになり、
         このウィンドウはアクティブ化しないため、アプリを前面に戻すクリックまで吸ってしまう。 -->
    <Grid x:Name="RootGrid">
        <!-- 操作 OSD: 案Y では映像子ウィンドウ（VideoHwndHost）が airspace で最前面になり本来の
             Grid 内オーバーレイが隠れるため、この透過オーバーレイ側で表示する（段階2-2a）。
             何か操作を行うたび一瞬だけ内容を表示する（無操作で自動的に消える）。常にクリックスルー。 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"
                Background="#B0000000" CornerRadius="4" Padding="14,6" IsHitTestVisible="False"
                Visibility="{Binding OsdText, Converter={StaticResource EmptyStringToVis}}">
            <TextBlock Text="{Binding OsdText}" Foreground="White" FontSize="16"/>
        </Border>

        <!-- フルスクリーン時の下部オーバーレイ: マウス移動・キー操作で一時表示し、無操作で自動的に消える。
             シークバーは入力を受けるため、フルスクリーン中のみクリックスルーを解除する（段階2-2b）。 -->
        <Border x:Name="FullscreenOverlay" VerticalAlignment="Bottom"
                Background="#CC000000" Padding="8,6" Visibility="Collapsed">
            <StackPanel>
                <ctrl:SeekBarControl x:Name="FullscreenSeekBar" Margin="0,0,0,4"
                                     PositionRatio="{Binding PositionRatio, Mode=TwoWay}"
                                     Duration="{Binding Duration}"
                                     ThumbnailSheet="{Binding ThumbnailSheet}"/>
                <TextBlock Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center">
                    <Run Text="{Binding Position, StringFormat={}{0:hh\\:mm\\:ss}}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
