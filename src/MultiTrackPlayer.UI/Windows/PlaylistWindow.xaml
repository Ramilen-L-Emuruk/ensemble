<Window x:Class="MultiTrackPlayer.UI.Windows.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MultiTrackPlayer.UI"
        Title="プレイリスト" Width="400" Height="400"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <ui:LoadedFileGlyphConverter x:Key="LoadedGlyph"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 選択はプレイリスト上の現在地（Playlist.CursorPath）とは別の状態へバインドする。
             SelectedIndex は既定で TwoWay のため現在地へ直結すると、行をクリックしただけで
             次に再生するファイルが書き換わる。
             HorizontalContentAlignment: 既定（Left）では行の内容が文字幅のままになり、
             TextTrimming が働かず長いパスが横スクロールになる。これが効くのは既定の
             ListBoxItem テンプレートがこの値を ContentPresenter へ渡しているため。
             ChapterWindow のように ControlTemplate を自作している側では効かない
             （あちらは ContentPresenter の既定 Stretch で全幅になっている） -->
        <ListBox x:Name="FileList" Grid.Row="0"
                 ItemsSource="{Binding Playlist.Files}"
                 SelectedIndex="{Binding Playlist.SelectedIndex}"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="FileList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" ToolTip="{Binding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 読み込まれているファイルの目印。選択（青いハイライト）はユーザーが
                             自由に動かせるので、どのファイルが入っているかは選択では表せない -->
                        <TextBlock Grid.Column="0" FontSize="10" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LoadedGlyph}">
                                    <Binding/>
                                    <Binding Path="DataContext.CurrentMedia"
                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.PlaybackState"
                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
            <Button Content="追加" Click="Add_Click" Padding="8,4" Margin="2"/>
            <Button Content="削除" Click="Remove_Click" Padding="8,4" Margin="2"/>
            <Button Content="クリア" Click="Clear_Click" Padding="8,4" Margin="2"/>
        </StackPanel>
    </Grid>
</Window>